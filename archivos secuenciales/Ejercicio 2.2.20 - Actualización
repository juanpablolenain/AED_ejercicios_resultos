A partir del siguiente archivo ALUMNOS ordenado por legajo:

Apellido y Nombre
Carrera (ISI - IEM - IQ)
Nº de Legajo
Fecha de Nacimiento
Fecha de Ingreso
D.N.I.
Sexo (M o F)
Fecha de último examen aprobado
Nota

se desea generar un archivo de salida, donde se actualice la fecha de aprobación del último exámen.
Para ello, se cuenta con información del último turno de exámen, según el siguiente detalle:

EXAMENES Ordenado por Nro_Legajo
Nro_Legajo Carrera Cod_Materia Fecha_Examen Nota

Se debe considerar que no necesariamente todos los alumnos se presentan en cada turno de exámen,
y que un alumno puede presentarse a rendir más de una materia en un mismo turno.
Supónganse ambas secuencias ordenadas por Número de Legajo.


ANÁLISIS PREVIO

- ALUMNOS es el archivo maestro, con un único registro por alumno.
- EXAMENES es el archivo de movimientos, donde puede haber cero, uno o varios registros para un mismo alumno.
- SALIDA será el nuevo maestro actualizado.



ACCION ejercicio 2.2.20 ES

    AMBIENTE

        fecha = registro
            dd: 1..31;
            mm: 1..12;
            aa: N(4);
        fin_registro;

        alumno = registro                                  // crear modelo y seguido archivo + variable registro
            AyN: AN(40);
            carrera: ("ISI","IQ","IEM");
            legajo: N(5);
            fecha_nacimiento: fecha;
            fecha_ingreso: fecha;
            dni: N(7);
            sexo: ("M","F");
            fecha_ult_examen_aprobado: fecha;
            nota: N(2);
        fin_registro;

        alumnos, salida: archivo de alumno ordenado por legajo;
        reg_alumnos, reg_salida: alumno;

        examen = registro
            legajo: N(5);
            carrera: ("ISI","IQ","IEM");
            cod_materia: N(3);
            fecha_examen: fecha;
            nota: N(2);
        fin_registro;

        examenes: archivo de examen ordenado por legajo;
        reg_examenes: examen;
        
        HV: N(5);
        aprobado: boolean;
        aux_fecha: fecha;
        aux_nota: N(2);

        SUBACCION leer_alumnos ES
            LEER(alumnos, reg_alumnos);
            SI FDA(alumnos) ENTONCES
                reg_alumnos.legajo:= HV;
            FIN_SI;
        FIN_SUBACCION;

        SUBACCION leer_examenes ES
            LEER(examenes, reg_examenes);
            SI FDA(examenes) ENTONCES
                reg_examenes.legajo:= HV;
            FIN_SI;
        FIN_SUBACCION;

        SUBACCION copia_directa_alumnos ES
            reg_salida:= reg_alumnos;
            GRABAR(salida, reg_salida);
        FIN_SUBACCION;

        SUBACCION actualizar_fecha_nota ES
            reg_salida:= reg_alumnos;
            SI (aprobado) ENTONCES
                reg_salida.fecha_ult_examen_aprobado:= aux_fecha;
                reg_salida.nota:= aux_nota;
            FIN_SI;
            GRABAR(salida, reg_salida);
        FIN_SUBACCION;

        SUBACCION comparar_fecha(f_actual,f_aux: fecha): boolean ES
            SI (f_actual.aa > f_aux.aa) ENTONCES
                comparar_fecha:= true;
            SINO 
                SI (f_actual.aa = f_aux.aa) Y (f_actual.mm > f_aux.mm) ENTONCES
                    comparar_fecha:= true;
                SINO 
                    SI (f_actual.aa = f_aux.aa) Y (f_actual.mm = f_aux.mm) Y (f_actual.dd >= f_aux.dd) ENTONCES
                        comparar_fecha:= true;
                    SINO
                        comparar_fecha:= false;
                    FIN_SI;
                FIN_SI;
            FIN_SI;
        FIN_SUBACCION;
          
                    
            


        PROCESO

            ABRIR E/(alumnos);
            ABRIR E/(examenes);
            ABRIR S/(salida);

            HV:= 99999;  // debe inicializarse antes que las lecturas

            leer_alumnos;
            leer_examenes;

            MIENTRAS (reg_alumnos.legajo <> HV) 0 (reg_examenes.legajo <> HV) HACER
                SI (reg_alumnos.legajo < reg_examenes.legajo) ENTONCES
                    copia_directa_alumnos;
                    leer_alumnos;
                SINO
                    SI (reg_alumnos.legajo > reg_examenes.legajo) ENTONCES
                        ESC("Error! Un alumno que no existe no puede rendir un examen");
                        leer_examenes;
                    SINO
                        aprobado:= false;
                        MIENTRAS (reg_alumnos.legajo = reg_examenes.legajo) HACER

                            SI (reg_examenes.nota >= 6) ENTONCES

                                SI NO(aprobado) ENTONCES // solo entra en el primer aprobado para guardar la referencia a la fecha
                                    aprobado:= true;
                                    aux_fecha:= reg_examenes.fecha_examen;
                                    aux_nota:= reg_examenes.nota;
                                SINO
                                    SI (comparar_fecha(reg_examenes.fecha_examen, aux_fecha)) ENTONCES
                                        aux_fecha:= reg_examenes.fecha_examen;
                                        aux_nota:= reg_examenes.nota;
                                    FIN_SI;
                                FIN_SI;

                            FIN_SI;
                            leer_examenes;
                        FIN_MIENTRAS
                        actualizar_fecha_nota;
                        leer_alumnos;
                    FIN_SI;
                FIN_SI;
            FIN_MIENTRAS;

            CERRAR(alumnos);
            CERRAR(examenes);
            CERRAR(salida);

FIN_ACCION;


        










